{
  "name": "@mrzli-jslib/generic-types",
  "version": "0.0.0",
  "description": "Generic types for TypeScript",
  "homepage": "https://github.com/mrzli-jslib/generic-types#readme",
  "bugs": {
    "url": "https://github.com/mrzli-jslib/generic-types/issues"
  },
  "license": "MIT",
  "author": "Goran Mržljak <goran.mrzljak@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrzli-jslib/generic-types.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fix": "bun run fmt && bun run lint:fix",
    "check": "bun run fmt:check && bun run lint",
    "test": "vitest run",
    "preflight": "bun run typecheck && bun run check && bun run test && bun run build",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
